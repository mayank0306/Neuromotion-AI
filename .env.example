# NeuroMotion Environment Configuration

# ┌─────────────────────────────────────────────────────────────────┐
# │ APPLICATION                                                     │
# └─────────────────────────────────────────────────────────────────┘
APP_NAME=NeuroMotion
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production

# ┌─────────────────────────────────────────────────────────────────┐
# │ DATABASE                                                        │
# └─────────────────────────────────────────────────────────────────┘
# PostgreSQL (Recommended for production)
DATABASE_URL=postgresql+asyncpg://neuromation:neuromotion@localhost:5432/neuromotion_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# SQLite (Development only)
# DATABASE_URL=sqlite+aiosqlite:///./neuromation_dev.db

# ┌─────────────────────────────────────────────────────────────────┐
# │ REDIS (Cache, Session, Message Queue)                           │
# └─────────────────────────────────────────────────────────────────┘
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# ┌─────────────────────────────────────────────────────────────────┐
# │ JWT AUTHENTICATION                                              │
# └─────────────────────────────────────────────────────────────────┘
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ┌─────────────────────────────────────────────────────────────────┐
# │ AI MODELS                                                       │
# └─────────────────────────────────────────────────────────────────┘
POSE_MODEL_PATH=models/blazepose
MODEL_CONFIDENCE_THRESHOLD=0.5
INPUT_SIZE=256,256

# ┌─────────────────────────────────────────────────────────────────┐
# │ STORAGE (AWS S3 Compatible)                                     │
# └─────────────────────────────────────────────────────────────────┘
S3_BUCKET=neuromotion-media
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
MAX_UPLOAD_SIZE_MB=100

# ┌─────────────────────────────────────────────────────────────────┐
# │ EMAIL                                                           │
# └─────────────────────────────────────────────────────────────────┘
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@sandbox.neuromation.ai
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=NeuroMotion <no-reply@neuromation.ai>

# ┌─────────────────────────────────────────────────────────────────┐
# │ PAYMENTS (Stripe)                                               │
# └─────────────────────────────────────────────────────────────────┘
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=https://neuromotion.ai/success
STRIPE_CANCEL_URL=https://neuromotion.ai/cancel

# ┌─────────────────────────────────────────────────────────────────┐
# │ FRONTEND                                                        │
# └─────────────────────────────────────────────────────────────────┘
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=NeuroMotion

# ┌─────────────────────────────────────────────────────────────────┐
# │ MONITORING & LOGGING                                            │
# └─────────────────────────────────────────────────────────────────┘
LOG_LEVEL=INFO
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
PROMETHEUS_ENABLED=true
ENABLE_TRACING=false

# ┌─────────────────────────────────────────────────────────────────┐
# │ FEATURE FLAGS                                                   │
# └─────────────────────────────────────────────────────────────────┘
ENABLE_TELEMEDICINE=false
ENABLE_GAIT_ANALYSIS=true
ENABLE_POSTURE_ASSESSMENT=true
ENABLE_DATA_EXPORT=true

# ┌─────────────────────────────────────────────────────────────────┐
# │ DEVELOPMENT                                                     │
# └─────────────────────────────────────────────────────────────────┘
ENABLE_DEBUG_TOOLBAR=false
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
